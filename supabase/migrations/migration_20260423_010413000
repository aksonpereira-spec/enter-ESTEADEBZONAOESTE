SELECT 'Zona Oeste', 'Akson Pereira da Silva', 'Erika Pereira da Silva', 2026
WHERE NOT EXISTS (SELECT 1 FROM public.nucleo_config LIMIT 1);

-- Add tipo_bolsa to alunos
ALTER TABLE public.alunos ADD COLUMN IF NOT EXISTS tipo_bolsa TEXT DEFAULT '';

-- Update coordinator and spouse with their tipo_bolsa from existing data
UPDATE public.alunos SET tipo_bolsa = 'Coordenador'
WHERE nome = 'Akson Pereira da Silva' AND (tipo_bolsa IS NULL OR tipo_bolsa = '');

UPDATE public.alunos SET tipo_bolsa = 'Esposa do Coordenador'
WHERE nome = 'Erika Pereira da Silva' AND (tipo_bolsa IS NULL OR tipo_bolsa = '');
