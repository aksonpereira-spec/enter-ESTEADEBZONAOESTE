
-- Config table for nucleo/coordenador
CREATE TABLE IF NOT EXISTS public.nucleo_config (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  nome_nucleo TEXT DEFAULT '',
  coordenador_nome TEXT DEFAULT '',
  coordenador_esposa_nome TEXT DEFAULT '',
  ano INTEGER DEFAULT 2026,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);
ALTER TABLE public.nucleo_config ENABLE ROW LEVEL SECURITY;

DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM pg_policies WHERE tablename = 'nucleo_config' AND policyname = 'Allow all nucleo_config'
  ) THEN
    CREATE POLICY "Allow all nucleo_config" ON public.nucleo_config FOR ALL USING (true) WITH CHECK (true);
  END IF;
END $$;

-- Insert default config (only if empty)
