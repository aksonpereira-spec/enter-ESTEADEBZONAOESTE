
CREATE TABLE IF NOT EXISTS calendario_aulas (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  data_aula DATE NOT NULL,
  professor TEXT DEFAULT '',
  disciplina TEXT DEFAULT '',
  obs TEXT DEFAULT '',
  provas_disciplinas TEXT DEFAULT '',
  created_at TIMESTAMPTZ DEFAULT NOW()
);
ALTER TABLE calendario_aulas ENABLE ROW LEVEL SECURITY;
CREATE POLICY "allow_all_calendario" ON calendario_aulas FOR ALL USING (true) WITH CHECK (true);
