
-- Trigger to auto-set coordenador_id in student_profiles from aluno
CREATE OR REPLACE FUNCTION fn_set_profile_coordenador()
RETURNS TRIGGER LANGUAGE plpgsql AS $$
BEGIN
  IF NEW.aluno_id IS NOT NULL THEN
    SELECT coordenador_id INTO NEW.coordenador_id FROM alunos WHERE id = NEW.aluno_id LIMIT 1;
  END IF;
  RETURN NEW;
END;
$$;

DROP TRIGGER IF EXISTS trg_profile_coordenador ON student_profiles;
CREATE TRIGGER trg_profile_coordenador
  BEFORE INSERT OR UPDATE OF aluno_id ON student_profiles
  FOR EACH ROW EXECUTE FUNCTION fn_set_profile_coordenador();

-- Update existing profiles that have aluno_id set
UPDATE student_profiles sp
SET coordenador_id = a.coordenador_id
FROM alunos a
WHERE sp.aluno_id = a.id
  AND sp.coordenador_id = '00000000-0000-0000-0000-000000000001';
